# AlgoForge Environment Variables
# Copy to .env and fill in real values

# Redis (override settings.yaml)
ALGOFORGE_REDIS__HOST=localhost
ALGOFORGE_REDIS__PORT=6379
ALGOFORGE_REDIS__PASSWORD=

# Market override
# ALGOFORGE_MARKET__SELECTED_MARKET=crypto
# ALGOFORGE_MARKET__TIMEFRAME_MODE=swing

# Logging override
# ALGOFORGE_LOGGING__LEVEL=DEBUG
# ALGOFORGE_LOGGING__FORMAT=console
